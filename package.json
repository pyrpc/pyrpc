{
  "name": "pyrpc-client-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/fastapi-nextjs",
    "examples/fastapi-react",
    "examples/fastapi-svelte",
    "examples/fastapi-vue",
    "examples/django-nextjs",
    "examples/django-react",
    "examples/django-svelte",
    "examples/django-vue",
    "examples/flask-nextjs",
    "examples/flask-react",
    "examples/flask-svelte",
    "examples/flask-vue"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "npm run test --workspaces",
    "test:python": "cd packages/pyrpc-core && python3 -m pytest",
    "test:client": "npm test --workspace=@pyrpc/client"
  },
  "devDependencies": {
    "likec4": "^1.58.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.62.3",
    "@vitest/pretty-format": "^4.1.10"
  }
}
