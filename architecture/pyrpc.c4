specification {
  element actor {
    style {
      shape person
      color secondary
    }
  }
  element system {
    style {
      shape component
      color muted
    }
  }
  element container {
    style {
      shape component
      color primary
    }
  }
  element component {
    style {
      shape rectangle
      color secondary
    }
  }
  element storage {
    style {
      shape storage
      color muted
    }
  }
}

model {
  // ═══════════════════════════════════════════
  // ACTORS
  // ═══════════════════════════════════════════
  python_dev = actor 'Python Developer' {
    description 'Writes @rpc-decorated functions in Python that become RPC endpoints. Uses pyrpc CLI for dev server and code generation.'
  }
  ts_dev = actor 'TypeScript Developer' {
    description 'Consumes the typed RPC client in frontend applications. Imports createClient<Types>() from @pyrpc/client.'
  }

  // ═══════════════════════════════════════════
  // EXTERNAL SYSTEMS
  // ═══════════════════════════════════════════
  jsonrpc_protocol = system 'JSON-RPC 2.0' {
    description 'Wire protocol standard defining the request/response envelope structure. pyrpc uses id, method, params, result, error fields.'
  }

  // ═══════════════════════════════════════════
  // pyRPC SYSTEM
  // ═══════════════════════════════════════════
  pyrpc = system 'pyRPC' {
    description 'Type-safe RPC framework for Python backends with TypeScript frontends. One @rpc decorator defines the endpoint, generates TS types, and validates every request at runtime.'

    pyrpc_core = container 'pyrpc-core' {
      description 'The heart of pyRPC. Contains the protocol implementation, router, request interpreter, CLI, introspection engine, ASGI transport, and Python client.'
      technology 'Python 3.11+ / Pydantic v2'

      core_router = component 'Router' {
        description 'Thread-safe registry managing named Procedure instances. Supports register(), merge(), get(), list(), reload_module() for hot-reload in dev mode.'
        technology 'registry.py'
      }
      core_procedure = component 'Procedure' {
        description 'Compiled RPC handler wrapping a Python function. Stores kind (query|mutation). At init time, pre-builds Pydantic TypeAdapters for all parameters and return type for zero-overhead validation on the hot path.'
        technology 'procedure.py'
      }
      core_rpc_dec = component '@rpc decorator' {
        description 'RpcDecorator on the Router: @rpc / @rpc.query / @rpc.mutation. Compiles a function into a Procedure with kind query|mutation (bare @rpc defaults to query) and registers it.'
        technology 'rpc_decorator.py / decorators.py'
      }
      core_model_dec = component '@model decorator' {
        description 'Alias for pydantic.dataclasses.dataclass. Marks Python classes for JSON Schema generation. Types derived from these are emitted as TypeScript interfaces by codegen.'
        technology 'decorators.py'
      }
      core_interpreter = component 'handle_request()' {
        description 'Core request dispatcher: validates the JSON-RPC 2.0 envelope via RpcRequest model, looks up the Procedure via Router, executes with validated params, returns a JSON-RPC 2.0 response. Accepts a single operation (dict) or a batch (list): batches dispatch sequentially through the normal path up to MAX_BATCH_SIZE 100, one response per operation in order, per-operation errors never fail siblings.'
        technology 'interpreter.py'
      }
      core_introspection = component 'get_registry_schema()' {
        description 'Single source of truth for both runtime introspection and TypeScript code generation. Reads Router._procedures and generates ProcedureSchema objects with parameter types, return types, JSON schemas, docstrings, and procedure kind.'
        technology 'introspection.py'
      }
      core_models = component 'RpcRequest / RpcResponse' {
        description 'Pydantic v2 models for the JSON-RPC 2.0 envelope. RpcRequest validates incoming payloads. RpcResponse structures success/error responses with typed ErrorModel.'
        technology 'models.py'
      }
      core_asgi = component 'PyRPCAsgiApp' {
        description 'Standalone ASGI application serving POST /rpc (RPC calls) and GET /rpc (introspection). Handles CORS headers, JSON parsing, and response serialization. Can be used directly without adapters.'
        technology 'transport/asgi.py'
      }
      core_cli = component 'CLI' {
        description 'Typer-based CLI with commands: dev (framework-native dev server, file watcher, live config reconfiguration, interactive console), watch (type regeneration only; explicit --module works without pyrpc.json), serve (production ASGI server), inspect (list procedures), pull (extract schema to JSON), codegen (generate TypeScript), version. The first-run wizard asks the backend framework first (sniffing mount_fastapi/mount_flask/mount_django markers only preselects; Enter confirms), then the framework-specific entry point, a required types_module for Django (auto-detected as the shallowest */views.py), and client roots via questionary.path with suggestions jailed to the project root. --yes sniffs or errors and never guesses; --framework <fastapi|flask|django|asgi> is fully explicit and validated before anything else runs.'
        technology 'cli.py / config.py / runners.py'
      }
      core_config = component 'BackendSpec config model' {
        description 'pyrpc.json IO and validation: find/read/write helpers, frozen BackendSpec(framework, entrypoint, types_module), parse_backend() rejecting unknown frameworks and normalizing FastAPI/Flask/ASGI entry points to module[:app] (Django keeps its manage.py path), clients_from_config() filtering valid { framework, root } entries. Legacy flat configs are treated as unconfigured so the next run rewrites them in place.'
        technology 'config.py'
      }
      core_runners = component 'Native launch resolver' {
        description 'resolve_launch(spec) returns a frozen LaunchPlan(argv, cwd): python -m uvicorn <module[:app]> for fastapi/asgi, python -m flask --app <module:app> run for Flask, python manage.py runserver host:port for Django (cwd set to manage.py directory, --noreload when reload is off). resolve_types_module() defaults to the entrypoint module part and refuses Django without an explicit types_module. Because plans are data, the config watcher can relaunch on change.'
        technology 'runners.py'
      }
      core_wiring = component 'tsconfig + bundler wiring' {
        description 'Injects "@pyrpc/types": ["./__pyrpc.ts"] into tsconfig paths via jsonc-edit (comment-preserving, idempotent, raises on conflicting aliases) and adds explicit bundler aliases for Vite, SvelteKit, and Next.js Turbopack, which ignore tsconfig paths for imports inside node_modules.'
        technology 'tsconfig.py / bundlers.py'
      }
      core_pyclient = component 'Python RPCClient' {
        description 'Dynamic Python client using httpx. Wraps sync/async HTTP calls. Auto-fetches schema via GET /rpc for method introspection. Supports named and positional arguments. Context manager compatible.'
        technology 'client/python_client.py'
      }
    }

    pyrpc_fastapi = container 'pyrpc-fastapi' {
      description 'FastAPI adapter. Registers POST /rpc and GET /rpc routes on a FastAPI application. Fully async, no bridging needed.'
      technology 'Python / FastAPI'

      fastapi_mount = component 'mount_fastapi()' {
        description 'Registers two async routes on a FastAPI app: POST /rpc calls await handle_request(), GET /rpc returns schema. Adheres to the "thin shell" pattern - zero protocol logic.'
        technology '__init__.py / 26 lines'
      }
    }

    pyrpc_flask = container 'pyrpc-flask' {
      description 'Flask adapter. Registers POST /rpc and GET /rpc routes on a Flask application. Uses anyio.run() to bridge Flask sync to async interpreter.'
      technology 'Python / Flask'

      flask_mount = component 'mount_flask()' {
        description 'Registers two sync routes. POST handler uses anyio.run(handle_request, payload, router) to bridge Flask sync world to the async interpreter. Flask and anyio imported lazily inside function to avoid hard dependency.'
        technology '__init__.py / 33 lines'
      }
    }

    pyrpc_django = container 'pyrpc-django-adapter' {
      description 'Django adapter. Extends a urlpatterns list with async POST /rpc and GET /rpc views decorated with @csrf_exempt.'
      technology 'Python / Django'

      django_mount = component 'mount_django()' {
        description 'Extends urlpatterns with two async Django views, both @csrf_exempt. POST view runs await handle_request(). GET view returns schema. Each view validates request.method explicitly.'
        technology '__init__.py / 38 lines'
      }
    }

    pyrpc_codegen = container 'pyrpc-codegen' {
      description 'Library for generating TypeScript type definitions from pyRPC schema. Converts Python type annotations and Pydantic JSON schemas into TypeScript interfaces and procedure signatures.'
      technology 'Python / Jinja2 / jsonschema_ts'

      codegen_generate = component 'generate_typescript_client()' {
        description 'Main entry point: collects JSON Schema defs from all procedures, generates TS model interfaces via jsonschema_ts, renders procedure signatures via Jinja2 template, assembles the complete TypeScript output.'
        technology 'ts_codegen.py'
      }
      codegen_save = component 'save_typescript_client()' {
        description 'Writes generated TypeScript to an absolute output path. Creates directories if needed. Raises ValueError if given a relative path. Called by CLI and pyrpc dev watcher.'
        technology 'ts_codegen.py'
      }
      codegen_py2ts = component '_pytype_to_ts()' {
        description 'Recursive Python type string to TypeScript type converter. Handles Optional, Union, List, Dict, Tuple, Set, class references, and nested generics. Also provides return_type_to_ts and _to_safe_name utilities.'
        technology 'ts_codegen.py'
      }
      codegen_template = component 'client.ts.j2' {
        description 'Jinja2 template that renders Types, ProcedureKinds, and procedureKinds. Uses custom Jinja2 filters (pytype_to_ts, return_type_to_ts) to convert Python types in the template context.'
        technology 'Jinja2 template'
      }
      codegen_jschema = component 'jsonschema_ts' {
        description 'Third-party library (npm). Converts Pydantic JSON Schema definitions into TypeScript interfaces. Pipeline: ensure_inline_models -> collect_defs -> convert_all -> assemble.'
        technology 'npm: jsonschema_ts'
      }
    }

    pyrpc_client = container '@pyrpc/client' {
      description 'Universal TypeScript client for pyRPC. Procedure calls become Operations that flow through a link pipeline ending in exactly one terminating link that owns the transport. Published on npm; type generation is handled by server-side pyrpc commands.'
      technology 'TypeScript / npm'

      client_proxy = component 'createClient<Types>()' {
        description 'Factory function returning a Proxy object. The Proxy intercepts procedure access and returns a callable that wraps the call as an Operation and hands it to the configured link pipeline. ClientOptions require exactly one terminating link; a missing or duplicated terminator is a construction error. Normalizes arguments: single object arg is sent as named params, positional args as array. The Types generic provides full type safety.'
        technology 'src/client.ts'
      }
      client_links = component 'httpLink / httpBatchLink' {
        description 'Terminating links owning fetch(). httpLink sends one operation per POST. httpBatchLink collects operations issued in the same scheduling window (setTimeout 0 flush, optional maxItems cap) into one JSON-array POST, then resolves or rejects each caller independently by response position. normalizeUrl accepts base URLs with or without trailing slash or /rpc suffix.'
        technology 'src/links.ts'
      }
      client_error = component 'PyRPCError' {
        description 'Custom Error subclass carrying code, message, and data fields from JSON-RPC error responses. Enables structured error handling on the client side.'
        technology 'src/error.ts'
      }
      client_types = component 'RpcRequest / RpcResponse / ClientOptions' {
        description 'TypeScript interfaces for the JSON-RPC 2.0 envelope and client configuration. RpcRequest: id, method, params. RpcResponse: id, result, error. ClientOptions: links pipeline (exactly one terminating link).'
        technology 'src/types.ts'
      }
    }

    pyrpc_types = container '@pyrpc/types' {
      description 'Placeholder npm package for the generated type boundary. Its src/index.ts exports fallback types and a procedureKinds proxy that throws until pyrpc dev/codegen wires @pyrpc/types to the generated <client>/__pyrpc.ts via tsconfig paths and bundler aliases.'
      technology 'TypeScript / npm'

      types_index = component '<client>/__pyrpc.ts' {
        description 'Generated runtime module. Contains model interfaces, export interface Types { ... }, export type ProcedureKinds, and export const procedureKinds. Framework adapters import @pyrpc/types, which resolves here during development.'
        technology 'generated TypeScript output'
      }
    }

    pyrpc_react = container '@pyrpc/react' {
      description 'React + TanStack Query adapter. Thin glue over @pyrpc/client: createReactClient, PyRPCProvider (QueryClientProvider convenience), per-procedure useQuery/useMutation, useUtils.'
      technology 'TypeScript / React / TanStack Query'

      react_factory = component 'createReactClient()' {
        description 'Builds createClient with the configured links, then a Proxy that exposes useQuery/useMutation per procedure. Kinds load from @pyrpc/types automatically; an explicit kinds override exists for tests. Re-exports httpLink and httpBatchLink so imports stay canonical.'
        technology 'src/createReactClient.ts'
      }
      react_provider = component 'PyRPCProvider' {
        description 'Convenience wrapper around TanStack Query QueryClientProvider. Not an auth/session context — same provider requirement as tRPC + React Query.'
        technology 'src/provider.tsx'
      }
      react_utils = component 'createUtils / useUtils' {
        description 'Invalidate, prefetch, fetch, and getQueryKey helpers keyed as ["pyrpc", procedure, input?].'
        technology 'src/utils.ts'
      }
    }

    pyrpc_next = container '@pyrpc/next' {
      description 'Next.js App Router adapter. createNextClient returns a bundle: React hooks api, createCaller, prefetch, dehydrate, HydrateClient, getQueryClient.'
      technology 'TypeScript / Next.js / React'

      next_factory = component 'createNextClient()' {
        description 'Composes createReactClient with RSC-safe getQueryClient (React cache on server, singleton in browser), prefetch helpers, dehydrate, and HydrateClient.'
        technology 'src/createNextClient.ts'
      }
      next_provider = component 'NextPyRPCProvider' {
        description 'App Router provider wiring the shared browser QueryClient into PyRPCProvider.'
        technology 'src/provider.tsx'
      }
      next_hydrate = component 'HydrateClient' {
        description 'Client boundary around TanStack HydrationBoundary for RSC-prefetched state.'
        technology 'src/HydrateClient.tsx'
      }
    }

    pyrpc_vue = container '@pyrpc/vue' {
      description 'Vue 3 + TanStack Query adapter via createVueClient. Uses VueQueryPlugin from TanStack (no extra pyRPC context).'
      technology 'TypeScript / Vue / TanStack Query'

      vue_factory = component 'createVueClient()' {
        description 'Proxy over createClient exposing useQuery/useMutation; kinds load from @pyrpc/types. Accepts and re-export the terminating links.'
        technology 'src/createVueClient.ts'
      }
    }

    pyrpc_svelte = container '@pyrpc/svelte' {
      description 'Svelte + TanStack Query adapter via createSvelteClient (createQuery/createMutation). Uses Svelte Query provider from TanStack.'
      technology 'TypeScript / Svelte / TanStack Query'

      svelte_factory = component 'createSvelteClient()' {
        description 'Proxy over createClient exposing createQuery/createMutation stores; kinds load from @pyrpc/types. Accepts and re-exports the terminating links.'
        technology 'src/createSvelteClient.ts'
      }
    }
  }

  // ═══════════════════════════════════════════
  // CONFIG FILES
  // ═══════════════════════════════════════════
  cfg_pyrpc_json = storage 'pyrpc.json' {
    description 'Project configuration file. Nested schema: backend { framework: fastapi|flask|django|asgi, entrypoint (module[:app] for FastAPI/Flask/ASGI, path to manage.py for Django), optional types_module } plus clients [{ framework, root }] (one or more TypeScript client roots). Written by the pyrpc dev wizard; legacy flat configs are rewritten in place on the next run. The running dev session watches this file and live-reconfigures.'
    technology 'JSON'
  }
  cfg_tsconfig = storage 'tsconfig.json + bundler config' {
    description 'The TypeScript project wiring that makes the @pyrpc/types import resolve to the generated __pyrpc.ts. pyrpc dev injects a compilerOptions.paths alias ("@pyrpc/types": ["./__pyrpc.ts"]) via jsonc-edit, plus an explicit bundler alias for Vite, SvelteKit, and Next.js Turbopack (which ignore tsconfig paths for imports inside node_modules).'
    technology 'JSON / JS'
  }

  // ═══════════════════════════════════════════════════════════════
  // RELATIONSHIPS
  // ═══════════════════════════════════════════════════════════════

  // ── Developer -> Code ──
  python_dev -> core_rpc_dec 'defines RPC endpoints via @rpc decorator' {
    description 'Each @rpc-decorated function becomes a named RPC endpoint with automatic parameter/return type validation.'
  }
  python_dev -> core_model_dec 'defines data models via @model decorator' {
    description 'Type-annotated dataclasses generate JSON Schema, which becomes TypeScript interfaces on the client.'
  }
  python_dev -> core_cli 'runs pyrpc dev / serve / codegen / inspect commands' {
    description 'CLI is the primary developer interface for running servers, inspecting procedures, and generating types.'
  }

  // ── Core Internal Flow ──
  core_rpc_dec -> core_router 'registers Procedure(name, fn) in the router' {
    description 'At import time, the decorator compiles the function into a Procedure and stores it in the Router.'
  }
  core_router -> core_procedure 'stores compiled Procedure with pre-built TypeAdapters' {
    description 'Each Procedure wraps the user function with pre-built Pydantic TypeAdapters for all parameters and return type.'
  }
  core_router -> core_procedure 'get(name) retrieves Procedure for dispatch' {
    description 'The interpreter looks up the Procedure by method name from the router.'
  }

  // ── Interpreter Dispatch ──
  core_interpreter -> core_models 'validates incoming JSON-RPC 2.0 envelope via RpcRequest.model_validate()' {
    description 'The interpreter uses Pydantic to validate that the incoming payload conforms to JSON-RPC 2.0 structure.'
  }
  core_interpreter -> core_router 'get(method) to look up the Procedure by name' {
    description 'After envelope validation, the interpreter searches the router for the named procedure.'
  }
  core_interpreter -> core_procedure 'execute(params) runs the function with Pydantic-validated arguments' {
    description 'The Procedure binds arguments, validates each via pre-built TypeAdapters, calls the function (sync or async), validates the return type, and returns the result.'
  }
  core_procedure -> jsonrpc_protocol 'conforms to JSON-RPC 2.0 request/response structure' {
    description 'The envelope (RpcRequest/RpcResponse) follows the JSON-RPC 2.0 specification for id, method, params, result, and error fields.'
  }

  // ── Adapter -> Interpreter ──
  fastapi_mount -> core_interpreter 'await handle_request(payload, router)' {
    description 'FastAPI is natively async, so the adapter directly awaits the core interpreter.'
  }
  flask_mount -> core_interpreter 'anyio.run(handle_request, payload, router)' {
    description 'Flask is synchronous, so the adapter uses anyio.run() to bridge to the async interpreter.'
  }
  django_mount -> core_interpreter 'await handle_request(payload, router)' {
    description 'Django supports async views natively (since 3.1), so the adapter awaits the interpreter directly.'
  }
  core_asgi -> core_interpreter 'await handle_request(payload, router)' {
    description 'The built-in ASGI application awaits the interpreter directly for POST /rpc requests.'
  }

  // ── Adapter -> Introspection (GET /rpc) ──
  fastapi_mount -> core_introspection 'GET /rpc: returns registry schema as JSON' {
    description 'All adapters expose GET /rpc for schema introspection. Returns ProcedureSchema data for every registered procedure.'
  }
  flask_mount -> core_introspection 'GET /rpc: returns registry schema as JSON'
  django_mount -> core_introspection 'GET /rpc: returns registry schema as JSON'
  core_asgi -> core_introspection 'GET /rpc: returns registry schema as JSON'

  // ── Introspection -> Router ──
  core_introspection -> core_router 'reads _procedures dict to build ProcedureSchema list' {
    description 'get_registry_schema() iterates the router procedures and generates a ProcedureSchema for each one.'
  }

  // ── CLI -> Everything ──
  core_cli -> core_config 'reads/writes pyrpc.json through the BackendSpec config model' {
    description 'dev, watch, and codegen locate pyrpc.json, parse it into a validated BackendSpec, and rewrite legacy flat configs in place.'
  }
  core_config -> cfg_pyrpc_json 'find / read / write the nested schema' {
    description 'Walking up from cwd to find pyrpc.json; writes preserve the backend/clients shape.'
  }
  core_cli -> core_runners 'dev resolves a LaunchPlan for the spec and spawns the native server' {
    description 'On startup and whenever the config watcher detects a backend change: terminate the owned process, resolve_launch(new spec), relaunch.'
  }
  core_runners -> pyrpc_fastapi 'python -m uvicorn <module[:app]>' {
    description 'FastAPI and ASGI backends run under uvicorn with optional --reload.'
  }
  core_runners -> pyrpc_flask 'python -m flask --app <module:app> run' {
    description 'Flask runs on its own dev server; no WSGI-to-ASGI bridge involved.'
  }
  core_runners -> pyrpc_django 'python manage.py runserver host:port' {
    description 'Django runs manage.py runserver from its own directory (--noreload when reload is off).'
  }
  core_wiring -> cfg_tsconfig 'writes paths and bundler alias entries' {
    description 'configure_tsconfig() and configure_bundler() keep @pyrpc/types pointed at ./__pyrpc.ts across TypeScript and supported bundlers.'
  }
  core_cli -> core_wiring 'injects @pyrpc/types resolution wiring' {
    description 'dev, watch, and codegen run the tsconfig/bundler configurators on every run.'
  }
  core_cli -> core_introspection 'pyrpc inspect reads schema; pyrpc codegen triggers generation' {
    description 'The CLI reads the registry schema for inspection, and passes it to codegen for TypeScript generation.'
  }
  core_cli -> core_pyclient 'pyrpc pull extracts schema and outputs as JSON file' {
    description 'The pull command uses module import and introspection to dump the schema to a JSON file.'
  }

  // ── Codegen Pipeline ──
  core_cli -> pyrpc_codegen 'pyrpc codegen triggers TypeScript generation from schema or module' {
    description 'The codegen command reads a schema (from file, URL, or module import) and generates TypeScript.'
  }
  codegen_generate -> codegen_py2ts 'converts Python type strings to TypeScript types recursively' {
    description 'Handles Optional[T] -> T | null, List[T] -> T[], Dict[K,V] -> Record<K,V>, Union[A,B] -> A | B, etc.'
  }
  codegen_generate -> codegen_template 'renders the Types interface with Jinja2 using pytype_to_ts/return_type_to_ts filters' {
    description 'The Jinja2 template iterates all procedures and renders method signatures with converted TypeScript types.'
  }
  codegen_generate -> codegen_jschema 'converts Pydantic JSON Schema definitions to TypeScript interfaces' {
    description 'jsonschema_ts takes the JSON Schema $defs and generates export interface declarations for each model.'
  }
  codegen_generate -> codegen_save 'writes assembled TypeScript output to absolute path' {
    description 'The assembled output (model interfaces + Types interface + ProcedureKinds + procedureKinds) is written to <client>/__pyrpc.ts.'
  }
  codegen_save -> types_index 'generates/overwrites <client>/__pyrpc.ts' {
    description 'The output file contains all model interfaces, the Types interface with every procedure signature, and the runtime procedureKinds map.'
  }
  cfg_tsconfig -> types_index 'resolves @pyrpc/types imports to ./__pyrpc.ts' {
    description 'TypeScript paths and framework bundler aliases point @pyrpc/types at the generated runtime module in the client source tree.'
  }

  // ── Client Relationships ──
  ts_dev -> client_proxy 'imports createClient<Types>() and calls procedures as local methods' {
    description 'The Proxy-based client translates method calls to HTTP POST /rpc requests. The Types generic provides full IDE autocompletion.'
  }
  ts_dev -> react_factory 'imports createReactClient for TanStack Query hooks' {
    description 'Framework adapters sit on top of createClient; procedure names stay flat.'
  }
  ts_dev -> next_factory 'imports createNextClient for App Router hooks + RSC prefetch' {
    description 'Next bundle includes api, createCaller, prefetch, dehydrate, HydrateClient.'
  }
  ts_dev -> vue_factory 'imports createVueClient'
  ts_dev -> svelte_factory 'imports createSvelteClient'

  react_factory -> client_proxy 'wraps createClient; no second transport'
  next_factory -> react_factory 'reuses createReactClient for api hooks'
  next_factory -> client_proxy 'createCaller uses createClient on the server'
  vue_factory -> client_proxy 'wraps createClient'
  svelte_factory -> client_proxy 'wraps createClient'
  react_factory -> types_index 'Types + procedureKinds generics'
  next_factory -> types_index 'Types + procedureKinds generics'
  react_provider -> react_factory 'provides QueryClient for hooks'
  next_provider -> react_provider 'App Router QueryClient wiring'
  next_hydrate -> next_factory 'rehydrates dehydrated prefetch state'
  client_proxy -> client_error 'throws PyRPCError on server error responses' {
    description 'When the server returns a JSON-RPC error, the client parses code, message, and data into a PyRPCError instance.'
  }
  client_proxy -> client_links 'hands each Operation to the one terminating link' {
    description 'Exactly one terminating link is required at construction; it owns all transport concerns including URL normalization.'
  }
  client_links -> fastapi_mount 'HTTP POST /rpc (single op or JSON-array batch)' {
    description 'httpLink posts one envelope per request; httpBatchLink coalesces same-tick operations into a single array request and demultiplexes responses by position.'
  }
  client_links -> flask_mount 'HTTP POST /rpc'
  client_links -> django_mount 'HTTP POST /rpc'
  client_links -> core_asgi 'HTTP POST /rpc'

  // ── Cross-boundary type safety ──
  types_index -> client_proxy 'Types generic parameter provides full type safety and autocompletion' {
    description 'The generated Types interface is passed as a generic to createClient<Types>(), enabling type-safe RPC calls with IDE autocompletion.'
  }
}

// ═══════════════════════════════════════════════════════════════
// VIEWS
// ═══════════════════════════════════════════════════════════════

views {
  // ── LEVEL 1: SYSTEM LANDSCAPE ──
  view index {
    title 'pyRPC - System Landscape'

    description 'High-level view of pyRPC showing how developers and external standards interact with the system.'

    include *
  }

  // ── LEVEL 2: CONTAINER DIAGRAM ──
  view of pyrpc {
    title 'pyRPC - Container Diagram'

    description 'Core (with the BackendSpec config model and native launch resolver), server adapters, codegen, @pyrpc/client/types with terminating links, framework adapters (react/next/vue/svelte), plus external actors and config files.'

    include *
  }

  // ── LEVEL 3d: FRAMEWORK ADAPTERS ──
  view framework_adapters {
    title 'Framework adapters - TanStack Query layer'

    description 'How @pyrpc/react, next, vue, and svelte sit on @pyrpc/client and @pyrpc/types without a second transport.'

    include client_proxy
    include types_index
    include react_factory
    include react_provider
    include react_utils
    include next_factory
    include next_provider
    include next_hydrate
    include vue_factory
    include svelte_factory
    include ts_dev
    include fastapi_mount

    style fastapi_mount {
      color muted
    }
  }

  // ── LEVEL 3a: pyrpc-core COMPONENTS ──
  view of pyrpc_core {
    title 'pyrpc-core - Internal Components'

    description 'Deep dive into the core package: the Router, Procedure compilation, request interpreter, introspection engine, ASGI transport, CLI, and Python client.'

    include *
    style python_dev {
      color muted
    }
    style jsonrpc_protocol {
      color muted
    }
  }

  // ── LEVEL 3b: pyrpc-codegen COMPONENTS ──
  view of pyrpc_codegen {
    title 'pyrpc-codegen - Pipeline Internals'

    description 'The TypeScript code generation pipeline: from runtime schema through type conversion, template rendering, and jsonschema_ts model interface generation.'

    include *
    style cfg_pyrpc_json {
      color muted
    }
  }

  // ── LEVEL 3c: @pyrpc/client COMPONENTS ──
  view of pyrpc_client {
    title '@pyrpc/client - Internal Components'

    description 'The TypeScript client internals: Proxy-based dispatch, error handling, and shared JSON-RPC envelope types.'

    include *
    style jsonrpc_protocol {
      color muted
    }
  }

  // ── LEVEL 4: ADAPTER PATTERN COMPARISON ──
  view adapters {
    title 'Adapter Pattern - Framework Integration Comparison'

    description 'Side-by-side comparison of all four adapter implementations. Each adapter follows the "thin shell" pattern: it translates HTTP into core interpreter calls without adding protocol logic.'

    include core_interpreter
    include core_introspection
    include core_asgi
    include fastapi_mount
    include flask_mount
    include django_mount
    include client_proxy
    include python_dev
    include cfg_pyrpc_json

    style python_dev {
      color muted
    }
    style client_proxy {
      color muted
    }
    style cfg_pyrpc_json {
      color muted
    }
  }

  // ── DYNAMIC: RPC CALL FLOW ──
  dynamic view rpc_call_flow {
    title 'RPC Call Flow - Request/Response Sequence'

    description 'The life cycle of an RPC call: from TypeScript client through HTTP, adapter, interpreter, and procedure execution, then back with a response.'

    include client_proxy
    include fastapi_mount
    include core_interpreter
    include core_router
    include core_procedure
    include core_models
    include client_error
    include client_links

    client_proxy -> client_links 'operation dispatched to terminating link' {
      description 'Exactly one terminating link owns all transport'
    }
    client_links -> fastapi_mount 'HTTP POST /rpc' {
      description 'Sends JSON-RPC 2.0 envelope with id, method, params'
    }
    fastapi_mount -> core_interpreter 'await handle_request(payload)' {
      description 'Adapter passes the parsed JSON payload to core'
    }
    core_interpreter -> core_models 'RpcRequest.model_validate()' {
      description 'Validates envelope structure, extracts method name'
    }
    core_interpreter -> core_router 'get(method)' {
      description 'Looks up compiled Procedure by name'
    }
    core_interpreter -> core_procedure 'execute(params)' {
      description 'Binds args, validates each via TypeAdapter, calls function'
    }
    core_procedure -> core_models 'validates return type via TypeAdapter' {
      description 'Validates return value against declared return type'
    }
    core_interpreter -> fastapi_mount 'returns RpcResponse dict' {
      description 'Structured JSON-RPC 2.0 response with result or error'
    }
    fastapi_mount -> client_proxy 'HTTP 200 JSON-RPC response' {
      description 'Serialized RpcResponse returned to client'
    }
    client_proxy -> client_error 'on error: throws PyRPCError' {
      description 'If error field is present, client creates and throws PyRPCError'
    }
  }

  // ── DYNAMIC: CODEFLOW ──
  dynamic view codegen_flow {
    title 'Codegen Flow - From @rpc to TypeScript Types'

    description 'How TypeScript type definitions are generated: starting from @rpc decorators at import time, through introspection, code generation, and final file write.'

    include core_rpc_dec
    include core_router
    include core_introspection
    include codegen_generate
    include codegen_py2ts
    include codegen_template
    include codegen_jschema
    include codegen_save
    include types_index
    include cfg_tsconfig
    include core_wiring
    include python_dev
    include core_cli

    python_dev -> core_rpc_dec 'writes @rpc functions' {
      description 'Developer decorates functions with @rpc'
    }
    core_rpc_dec -> core_router 'registers Procedure(name, fn)' {
      description 'At import time, decorator creates and registers Procedure'
    }
    core_cli -> core_introspection 'pyrpc codegen invokes get_registry_schema()' {
      description 'CLI triggers schema extraction from router'
    }
    core_introspection -> core_router 'reads _procedures' {
      description 'get_registry_schema() iterates all registered procedures'
    }
    core_introspection -> codegen_generate 'passes ProcedureSchema dict' {
      description 'Schema data is passed to TypeScript generator'
    }
    codegen_generate -> codegen_py2ts 'converts Python type annotations' {
      description 'Python types (int, str, Optional, List, etc.) converted to TypeScript'
    }
    codegen_generate -> codegen_template 'renders Types interface' {
      description 'Jinja2 template generates method signatures with TS types'
    }
    codegen_generate -> codegen_jschema 'generates model interfaces' {
      description 'Pydantic JSON schemas converted to TypeScript interfaces'
    }
    codegen_generate -> codegen_save 'assembles and writes output' {
      description 'Combines model interfaces + Types interface, writes to file'
    }
    codegen_save -> types_index 'writes <client>/__pyrpc.ts' {
      description 'Final TypeScript runtime module in the client source tree'
    }
    core_cli -> core_wiring 'configures @pyrpc/types alias' {
      description 'configure_tsconfig() and configure_bundler() keep imports pointed at the generated module'
    }
    core_wiring -> cfg_tsconfig 'writes paths + bundler entries' {
      description 'Idempotent jsonc-edit injection plus explicit Vite/SvelteKit/Turbopack aliases'
    }
    cfg_tsconfig -> types_index 'resolves @pyrpc/types imports' {
      description 'Framework adapters consume @pyrpc/types, which resolves to ./__pyrpc.ts'
    }
  }

  // ── DYNAMIC: DEV LOOP ──
  dynamic view dev_loop_flow {
    title 'Dev Loop - pyrpc dev File Watching & Hot Reload'

    description 'The interactive development loop: pyrpc dev starts a server, watches Python files for changes, debounces regeneration, and provides an interactive console.'

    include core_cli
    include core_config
    include core_runners
    include cfg_pyrpc_json
    include cfg_tsconfig
    include python_dev
    include core_router
    include core_introspection
    include codegen_save
    include types_index
    include fastapi_mount

    python_dev -> core_cli 'pyrpc dev' {
      description 'Developer starts the dev server'
    }
    core_cli -> core_config 'find + parse_backend()' {
      description 'Locates pyrpc.json and parses it into a validated BackendSpec(framework, entrypoint, types_module)'
    }
    core_config -> python_dev 'wizard when unconfigured' {
      description 'Asks the backend framework first (sniffing only preselects), then entry point, django types_module, and client roots with jailed path autocomplete'
    }
    core_config -> cfg_pyrpc_json 'writes pyrpc.json on first run' {
      description 'Nested backend/clients schema; legacy files are rewritten in place'
    }
    core_cli -> core_runners 'resolve_launch(spec)' {
      description 'Returns a LaunchPlan for the framework-native server'
    }
    core_runners -> fastapi_mount 'spawns uvicorn | flask run | manage.py runserver' {
      description 'The configured framework hosts its own dev server; pyRPC never substitutes for it'
    }
    core_cli -> cfg_tsconfig 'configures type resolution' {
      description 'Injects @pyrpc/types paths alias and supported framework bundler alias'
    }
    core_cli -> python_dev 'imports user module' {
      description 'Imports the entry point to trigger @rpc registration'
    }
    core_cli -> core_cli 'starts file watcher' {
      description 'watchfiles monitors .py files in project directories'
    }
    core_cli -> core_cli 'starts native server + dev console' {
      description 'The resolved LaunchPlan process starts and interactive console (pyrpc>) opens'
    }
    python_dev -> core_cli 'edits .py file' {
      description 'Developer changes a Python file'
    }
    core_cli -> core_router 'reload_module() after debounce (300ms)' {
      description 'Re-imports module, clears and re-populates router procedures'
    }
    core_router -> core_introspection 'get_registry_schema()' {
      description 'Extracts updated schema from router'
    }
    core_introspection -> codegen_save 'save_typescript_client()' {
      description 'Regenerates TypeScript types from updated schema'
    }
    codegen_save -> types_index 'overwrites <client>/__pyrpc.ts' {
      description 'Generated type/runtime module updated on disk'
    }
    core_cli -> python_dev 'console output: regenerated N procs' {
      description 'Console confirms regeneration and shows procedure count'
    }
  }

  // ── DYNAMIC: LIVE RECONFIGURATION ──
  dynamic view reconfigure_flow {
    title 'Live Reconfiguration - editing pyrpc.json while dev runs'

    description 'The config watcher diffs the parsed BackendSpec on every save: a backend change imports the new types module and relaunches the native server; a clients-only change re-points codegen without touching the running server.'

    include python_dev
    include cfg_pyrpc_json
    include core_config
    include core_cli
    include core_runners
    include core_introspection
    include codegen_save
    include types_index
    include fastapi_mount

    python_dev -> cfg_pyrpc_json 'edits backend or clients section' {
      description 'Any editor change to the nested schema while the session runs'
    }
    cfg_pyrpc_json -> core_cli 'watchfiles event' {
      description 'The config watcher monitors the file and re-reads it'
    }
    core_cli -> core_config 'parse_backend(new_cfg)' {
      description 'Parse into a fresh BackendSpec instead of diffing file bytes'
    }
    core_config -> core_cli 'BackendSpec differs from current spec' {
      description 'Dataclass equality makes the diff precise; comment or formatting churn is ignored'
    }
    core_cli -> core_introspection 'import new types_module' {
      description 'Registration module imported before anything restarts; failure keeps the old spec alive'
    }
    core_cli -> core_runners 'resolve_launch(new spec)' {
      description 'Only when pyRPC owns the server process'
    }
    core_runners -> fastapi_mount 'terminate old, relaunch native server' {
      description 'Switching framework mid-session genuinely swaps runtimes'
    }
    core_cli -> codegen_save 're-wire regen callback' {
      description 'Clients-only changes re-point codegen at new roots with no restart'
    }
  }
}
