{
  "name": "@pyrpc/svelte",
  "version": "0.9.0",
  "description": "Svelte + TanStack Query adapter for pyRPC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external svelte --external @tanstack/svelte-query --external @pyrpc/client",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts --external svelte --external @tanstack/svelte-query --external @pyrpc/client",
    "test": "vitest run"
  },
  "keywords": [
    "rpc",
    "pyrpc",
    "svelte",
    "tanstack-query"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@pyrpc/client": "^0.9.0",
    "@pyrpc/types": "^0.9.0",
    "@tanstack/svelte-query": "^5.0.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@pyrpc/client": "*",
    "@pyrpc/types": "*",
    "@tanstack/svelte-query": "^5.83.0",
    "svelte": "^5.35.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
