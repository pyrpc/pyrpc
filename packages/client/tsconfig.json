{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "dist",
    "types": [
      "node"
    ],
    "paths": {
      "@pyrpc/types": [
        "./src/__pyrpc.d.ts"
      ]
    }
  },
  "include": [
    "src    *"
  ]
}
