{
  "name": "@pyrpc/next",
  "version": "0.12.1",
  "description": "Next.js App Router adapter for pyRPC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "require": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "keywords": [
    "rpc",
    "pyrpc",
    "nextjs",
    "next",
    "react",
    "tanstack-query"
  ],
  "license": "MIT",
  "dependencies": {
    "@pyrpc/client": "^0.12.1",
    "@pyrpc/react": "^0.12.1",
    "@pyrpc/types": "^0.12.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@pyrpc/client": "*",
    "@pyrpc/react": "*",
    "@pyrpc/types": "*",
    "@tanstack/react-query": "^5.83.0",
    "@types/react": "^19.1.8",
    "next": "^15.4.2",
    "react": "^19.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
