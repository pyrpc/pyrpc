{
  "name": "@pyrpc/react",
  "version": "0.14.0",
  "description": "React + TanStack Query adapter for pyRPC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --external @tanstack/react-query --external @pyrpc/client --external @pyrpc/types",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts --external react --external @tanstack/react-query --external @pyrpc/client --external @pyrpc/types",
    "test": "vitest run"
  },
  "keywords": [
    "rpc",
    "pyrpc",
    "react",
    "tanstack-query",
    "react-query"
  ],
  "license": "MIT",
  "dependencies": {
    "@pyrpc/client": "^0.14.0",
    "@pyrpc/types": "^0.14.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@pyrpc/client": "*",
    "@pyrpc/types": "*",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
