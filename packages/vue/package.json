{
  "name": "@pyrpc/vue",
  "version": "0.14.0",
  "description": "Vue + TanStack Query adapter for pyRPC",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external vue --external @tanstack/vue-query --external @pyrpc/client --external @pyrpc/types",
    "typecheck": "tsc --noEmit",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts --external vue --external @tanstack/vue-query --external @pyrpc/client --external @pyrpc/types",
    "test": "vitest run"
  },
  "keywords": [
    "rpc",
    "pyrpc",
    "vue",
    "tanstack-query"
  ],
  "license": "MIT",
  "dependencies": {
    "@pyrpc/client": "^0.14.0",
    "@pyrpc/types": "^0.14.0"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@pyrpc/client": "*",
    "@pyrpc/types": "*",
    "@tanstack/vue-query": "^5.102.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  }
}
